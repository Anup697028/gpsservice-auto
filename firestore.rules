rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isRole(role) {
      return isSignedIn() && (
        (role == 'RH' && isRhDirectoryRole(userRole()))
        || (role == 'FO' && (
          userRole() == 'FO'
          || userRole() == 'FIELD_OPERATOR'
          || userRole() == 'field_operator'
          || userRole() == 'Field Operator'
          || userRole() == null
        ))
        || (role == 'PAYMENT' && isPaymentRole(userRole()))
        || (role == 'VENDOR' && isVendorRole(userRole()))
        || (role == 'ADMIN' && isAdminRole(userRole()))
        || userRole() == role
      );
    }

    function isOwner(resourceData) {
      return resourceData.createdBy == request.auth.uid;
    }

    function normalizedAuthEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isRhDirectoryRole(roleValue) {
      return roleValue in [
        'RH',
        'rh',
        'Rh',
        'REGIONAL_HEAD',
        'regional_head',
        'Regional Head',
        'regional head',
        'REGIONAL HEAD',
        'REGIONALHEAD',
        'regionalhead',
        'RegionalHead',
        'regionalHead',
        'regional-head',
        'REGIONAL-HEAD',
        'regional heads',
        'Regional Heads',
        'REGIONAL HEADS',
        'REGIONAL_HEADS',
        'regional_heads',
        'REGIONALHEADS',
        'regionalheads',
        'RegionalHeads',
        'regional-heads',
        'REGIONAL-HEADS'
      ];
    }

    function isRhDirectoryUser(userData) {
      return isRhDirectoryRole(userData.role)
        || isRhDirectoryRole(userData.userRole)
        || isRhDirectoryRole(userData.designation)
        || isRhDirectoryRole(userData.type)
        || (userData.profile is map
          && (
            isRhDirectoryRole(userData.profile.role)
            || isRhDirectoryRole(userData.profile.userRole)
            || isRhDirectoryRole(userData.profile.designation)
            || isRhDirectoryRole(userData.profile.type)
          ))
        || (userData.userProfile is map
          && (
            isRhDirectoryRole(userData.userProfile.role)
            || isRhDirectoryRole(userData.userProfile.userRole)
            || isRhDirectoryRole(userData.userProfile.designation)
            || isRhDirectoryRole(userData.userProfile.type)
          ))
        || (userData.metadata is map
          && (
            isRhDirectoryRole(userData.metadata.role)
            || isRhDirectoryRole(userData.metadata.userRole)
            || isRhDirectoryRole(userData.metadata.designation)
            || isRhDirectoryRole(userData.metadata.type)
          ));
    }

    function isPaymentRole(roleValue) {
      return roleValue is string
        && (
          roleValue.lower().matches('^\\s*payment\\s*$')
          || roleValue.lower().matches('^\\s*fin\\s*$')
          || roleValue.lower().matches('^\\s*finance\\s*$')
          || roleValue.lower().matches('^\\s*payment[\\s_-]*team\\s*$')
          || roleValue.lower().matches('^\\s*paymentteam\\s*$')
        );
    }

    function isVendorRole(roleValue) {
      return roleValue is string
        && (
          roleValue.lower().matches('^\\s*vendor\\s*$')
          || roleValue.lower().matches('^\\s*vnd\\s*$')
          || roleValue.lower().matches('^\\s*vendor[\\s_-]*team\\s*$')
          || roleValue.lower().matches('^\\s*vendorteam\\s*$')
        );
    }

    function isAdminRole(roleValue) {
      return roleValue is string
        && (
          roleValue.lower().matches('^\\s*admin\\s*$')
          || roleValue.lower().matches('^\\s*administrator\\s*$')
        );
    }

    function hasRhAssignment(resourceData) {
      return resourceData.assignedRhUserId != null
        || resourceData.assignedRhEmail != null
        || resourceData.assignedRhEmailNormalized != null;
    }

    function isLegacyFallbackRh() {
      return request.auth.token.email == 'anupgogeri697@gmail.com';
    }

    function isAssignedRh(resourceData) {
      return (
        hasRhAssignment(resourceData)
        && (
          resourceData.assignedRhUserId == request.auth.uid
          || resourceData.assignedRhEmail == request.auth.token.email
          || resourceData.assignedRhEmail == normalizedAuthEmail()
          || resourceData.assignedRhEmailNormalized == normalizedAuthEmail()
        )
      ) || (
        !hasRhAssignment(resourceData)
        && isLegacyFallbackRh()
      );
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function isBulkRequest(resourceData) {
      return resourceData.isBulkRequest == true
        || resourceData.isBulkRequest == 'true'
        || resourceData.isBulkRequest == 'TRUE'
        || resourceData.isBulkRequest == 'True'
        || resourceData.isBulkRequest == 1
        || resourceData.isBulkRequest == '1'
        || resourceData.isBulkRequest == 'yes'
        || resourceData.isBulkRequest == 'YES'
        || resourceData.isBulkRequest == 'Yes';
    }

    function isSingleRequest(resourceData) {
      return !isBulkRequest(resourceData);
    }

    function lowerString(value) {
      return value is string
        ? value.lower()
        : '';
    }

    function isLegacyStringSingleRequest(resourceData) {
      return resourceData.isBulkRequest == 'false'
        || resourceData.isBulkRequest == 'FALSE'
        || resourceData.isBulkRequest == 'False'
        || resourceData.isBulkRequest == 0
        || resourceData.isBulkRequest == '0'
        || resourceData.isBulkRequest == 'no'
        || resourceData.isBulkRequest == 'NO'
        || resourceData.isBulkRequest == 'No';
    }

    function normalizedStatus(resourceData) {
      return lowerString(resourceData.status);
    }

    function isPaymentReviewStatus(resourceData) {
      let status = normalizedStatus(resourceData);
      return status in ['parallel_review', 'fo_created', 'payment_pending'];
    }

    function isAllowedPaymentBulkNextStatus(resourceData) {
      let status = normalizedStatus(resourceData);
      return status in ['parallel_review', 'fo_created', 'payment_pending', 'payment_approved', 'vendor_coordination', 'halted'];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isRhDirectoryUser(resource.data)
      );
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /requests/{requestId} {
      allow create: if isRole('FO')
        && request.resource.data.createdBy == request.auth.uid;

      // Role-scoped visibility:
      // - FO: own requests only
      // - RH: assigned requests only
      // - PAYMENT/VENDOR/ADMIN: workflow-wide visibility
      allow read: if isRole('ADMIN')
        || isRole('PAYMENT')
        || isRole('VENDOR')
        || (isRole('FO') && isOwner(resource.data))
        || (isRole('RH') && isAssignedRh(resource.data));

      // ========================================
      // SINGLE REQUEST WORKFLOW
      // ========================================

      // RH approval ONLY at PARALLEL_REVIEW stage
      allow update: if isRole('RH')
        && isAssignedRh(resource.data)
        && resource.data.status == 'PARALLEL_REVIEW'
        && !resource.data.isBulkRequest
        && request.resource.data.status == resource.data.status
        && onlyChanges(['rhApproval', 'rhActionTaken', 'rhStatus', 'rhApprovedAt', 'status', 'updatedAt', 'history', 'rejectionReason', 'clientName', 'city']);

      // RH approval when payment has already moved request to VENDOR_COORDINATION
      allow update: if isRole('RH')
        && isAssignedRh(resource.data)
        && resource.data.status == 'VENDOR_COORDINATION'
        && !resource.data.isBulkRequest
        && request.resource.data.status == 'VENDOR_COORDINATION'
        && onlyChanges(['rhApproval', 'rhActionTaken', 'rhStatus', 'rhApprovedAt', 'status', 'updatedAt', 'history']);

      // RH compliance approval can also be recorded after request completion
      allow update: if isRole('RH')
        && isAssignedRh(resource.data)
        && resource.data.status == 'COMPLETED'
        && !resource.data.isBulkRequest
        && request.resource.data.status == 'COMPLETED'
        && onlyChanges(['rhApproval', 'rhActionTaken', 'rhStatus', 'rhApprovedAt', 'status', 'updatedAt', 'history']);

      // RH rejection of single requests (ONLY at PARALLEL_REVIEW)
      allow update: if isRole('RH')
        && isAssignedRh(resource.data)
        && resource.data.status == 'PARALLEL_REVIEW'
        && !resource.data.isBulkRequest
        && request.resource.data.status == 'HALTED'
        && onlyChanges(['status', 'rhStatus', 'rhActionTaken', 'rejectionReason', 'updatedAt', 'history']);

      // Payment approval moves from PARALLEL_REVIEW to VENDOR_COORDINATION
      allow update: if isRole('PAYMENT')
        && isPaymentReviewStatus(resource.data)
        && isSingleRequest(resource.data)
        && lowerString(request.resource.data.status) == 'vendor_coordination'
        && onlyChanges(['paymentApproval', 'paymentApproved', 'paymentRejected', 'paymentActionTaken', 'paymentStatus', 'paymentApprovedAt', 'status', 'updatedAt', 'history', 'rejectionReason', 'clientName', 'city']);

      // Payment rejection at PARALLEL_REVIEW
      allow update: if isRole('PAYMENT')
        && isPaymentReviewStatus(resource.data)
        && isSingleRequest(resource.data)
        && lowerString(request.resource.data.status) == 'halted'
        && onlyChanges(['status', 'rejectionReason', 'paymentApproved', 'paymentRejected', 'paymentActionTaken', 'paymentStatus', 'paymentRejectedAt', 'updatedAt', 'history']);

      // Single request vendor notification
      allow update: if isRole('VENDOR')
        && resource.data.status == 'VENDOR_COORDINATION'
        && !resource.data.isBulkRequest
        && onlyChanges(['vendorName', 'notificationTimestamp', 'vendorApprovedAt', 'vendorApprovedBy', 'vendorNotified', 'vendorActionTaken', 'approvedByVendor', 'notifiedAt', 'updatedAt', 'history']);

      allow update: if isRole('VENDOR')
        && resource.data.status == 'VENDOR_COORDINATION'
        && !resource.data.isBulkRequest
        && request.resource.data.status == 'COMPLETED'
        && onlyChanges(['vendorName', 'status', 'notificationTimestamp', 'vendorApprovedAt', 'vendorApprovedBy', 'vendorNotified', 'vendorActionTaken', 'approvedByVendor', 'notifiedAt', 'updatedAt', 'history']);

      // Single request vendor notification flags after status has moved to COMPLETED
      allow update: if isRole('VENDOR')
        && !resource.data.isBulkRequest
        && resource.data.status == 'COMPLETED'
        && onlyChanges(['vendorName', 'notificationTimestamp', 'vendorNotified', 'vendorActionTaken', 'approvedByVendor', 'notifiedAt', 'updatedAt']);

      // ========================================
      // BULK REQUEST WORKFLOW (PARALLEL APPROVAL)
      // ========================================

      // RH bulk approval at FO_CREATED (parallel workflow)
      // Can stay at FO_CREATED (waiting for Payment) or move to PAYMENT_APPROVED (if Payment already approved)
      // Allows vehicles array update for vehicle-level rhApproved/rhRejected fields
      allow update: if isRole('RH')
        && isAssignedRh(resource.data)
        && (resource.data.status in ['PARALLEL_REVIEW', 'FO_CREATED', 'PAYMENT_PENDING', 'PAYMENT_APPROVED', 'VENDOR_COORDINATION', 'SERVICE_INITIATED', 'COMPLETED'])
        && resource.data.isBulkRequest == true
        && (request.resource.data.status in ['PARALLEL_REVIEW', 'FO_CREATED', 'PAYMENT_PENDING', 'PAYMENT_APPROVED', 'VENDOR_COORDINATION', 'SERVICE_INITIATED', 'COMPLETED'])
        && onlyChanges(['status', 'rhStatus', 'rhApprovedAt', 'bothApproved', 'vehicles', 'updatedAt', 'history']);

      // RH bulk rejection (ONLY at FO_CREATED)
      allow update: if isRole('RH')
        && isAssignedRh(resource.data)
        && resource.data.status in ['PARALLEL_REVIEW', 'FO_CREATED', 'PAYMENT_PENDING']
        && resource.data.isBulkRequest == true
        && request.resource.data.status == 'HALTED'
        && onlyChanges(['status', 'rhStatus', 'rejectionReason', 'updatedAt', 'history']);

      // RH per-vehicle rejection (mark individual vehicles as rejected without changing request status)
      allow update: if isRole('RH')
        && isBulkRequest(resource.data)
        && request.resource.data.status == resource.data.status
        && onlyChanges(['vehicles', 'updatedAt', 'history']);

      // Payment bulk actions in unified flow (supports per-vehicle approve/reject)
      allow update: if isRole('PAYMENT')
        && (isBulkRequest(resource.data) || isLegacyStringSingleRequest(resource.data))
        && isPaymentReviewStatus(resource.data)
        && isAllowedPaymentBulkNextStatus(request.resource.data)
        && onlyChanges(['status', 'paymentStatus', 'paymentApprovedAt', 'rejectionReason', 'bothApproved', 'vehicles', 'updatedAt', 'history']);

      // Payment legacy-compatibility fallback:
      // Allows payment writes for older request shapes/status variants as long as
      // only payment-owned workflow fields are being changed.
      allow update: if isRole('PAYMENT')
        && lowerString(request.resource.data.status) in ['parallel_review', 'fo_created', 'payment_pending', 'payment_approved', 'vendor_coordination', 'halted']
        && onlyChanges([
          'status',
          'paymentApproval',
          'paymentApproved',
          'paymentRejected',
          'paymentActionTaken',
          'paymentStatus',
          'paymentApprovedAt',
          'paymentRejectedAt',
          'rejectionReason',
          'bothApproved',
          'vehicles',
          'updatedAt',
          'history',
          'clientName',
          'city'
        ]);

      // Vendor bulk notification in unified flow
      allow update: if isRole('VENDOR')
        && resource.data.isBulkRequest == true
        && resource.data.status in ['VENDOR_COORDINATION', 'PAYMENT_APPROVED']
        && request.resource.data.status in ['COMPLETED', 'SERVICE_INITIATED']
        && onlyChanges(['vendorStatus', 'vendorName', 'vendorApprovedAt', 'vendorApprovedBy', 'vendorNotified', 'notifiedAt', 'notificationTimestamp', 'status', 'vehicles', 'updatedAt', 'history']);

      // Bulk request vendor notification flags after status has moved to SERVICE_INITIATED
      allow update: if isRole('VENDOR')
        && resource.data.isBulkRequest == true
        && resource.data.status == 'SERVICE_INITIATED'
        && onlyChanges(['vendorNotified', 'notifiedAt', 'notificationTimestamp', 'updatedAt']);

      // Vendor can notify FO for bulk requests (after vendor notification)
      allow update: if isRole('VENDOR')
        && resource.data.isBulkRequest == true
        && resource.data.status in ['SERVICE_INITIATED', 'COMPLETED']
        && onlyChanges(['foNotified', 'notifiedAt', 'updatedAt']);

      // Vendor can notify FO for single requests (after vendor notification)
      allow update: if isRole('VENDOR')
        && !resource.data.isBulkRequest
        && resource.data.status in ['VENDOR_COORDINATION', 'SERVICE_INITIATED', 'COMPLETED']
        && onlyChanges(['foNotified', 'notifiedAt', 'updatedAt']);

      // Vendor can only READ PAYMENT_APPROVED bulk requests if bothApproved=true
      // This is enforced through the read rule above that checks the status field

      // ========================================
      // COMMON OPERATIONS (Both Workflows)
      // ========================================

      // FO can cancel at various stages
      allow update: if isRole('FO')
        && isOwner(resource.data)
        && resource.data.status in ['PARALLEL_REVIEW', 'FO_CREATED', 'PAYMENT_PENDING', 'PAYMENT_APPROVED', 'VENDOR_COORDINATION', 'SERVICE_INITIATED', 'HALTED', 'REQUEST_CREATED']
        && request.resource.data.status == 'CANCELLED'
        && onlyChanges(['status', 'updatedAt', 'history']);

      // FO can remove one vehicle from a bulk request while still in early pending stages
      allow update: if isRole('FO')
        && isOwner(resource.data)
        && resource.data.isBulkRequest == true
        && resource.data.status in ['PARALLEL_REVIEW', 'FO_CREATED', 'PAYMENT_PENDING']
        && request.resource.data.status == resource.data.status
        && onlyChanges(['vehicles', 'ltpocDetails', 'vehicleCount', 'status', 'updatedAt', 'history']);

      // Admin override
      allow update: if isRole('ADMIN');
    }
  }
}
