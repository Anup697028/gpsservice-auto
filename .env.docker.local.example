# Copy to .env.docker.local and fill real values.
# This file is used by docker-compose.yml for local Docker runs.

# API port exposed on host and used inside the API container.
API_PORT=3002

# Postgres credentials used by db service and API DATABASE_URL.
POSTGRES_DB=gps_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password

# Absolute host path to your Firebase Admin service account JSON.
# Windows example:
# FIREBASE_SERVICE_ACCOUNT_FILE=C:/Users/HP/gps/gps-integration-b1a2e-firebase-adminsdk-fbsvc-85d47bd9e0.json
FIREBASE_SERVICE_ACCOUNT_FILE=C:/path/to/firebase-adminsdk.json
