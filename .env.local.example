# Firebase Configuration (Authentication Only)
# Get these values from your Firebase Console
# https://console.firebase.google.com

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# PostgreSQL API Configuration (Direct, No Cloud Functions)
# This is the Express API server that handles all business logic
VITE_API_BASE_URL=http://localhost:3001
VITE_FO_API_BASE_URL=http://localhost:3001

# Development Firebase Emulator (optional)
VITE_USE_EMULATORS=false

# Example production values (DO NOT USE IN DEVELOPMENT):
# VITE_FIREBASE_API_KEY=AIzaSyDemoKey1234567890
# VITE_FIREBASE_AUTH_DOMAIN=gps-automation.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=gps-automation
# VITE_FIREBASE_STORAGE_BUCKET=gps-automation.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_FO_API_BASE_URL=https://api.yourdomain.com
