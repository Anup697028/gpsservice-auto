# Copy to api/.env and fill real values.

# API runtime
NODE_ENV=production
PORT=3002

# In Docker Compose this is overridden to use the db container host.
DATABASE_URL=postgresql://postgres:change-this-strong-password@localhost:5432/gps_app?schema=public&sslmode=disable

# Firebase Admin (project ID is safe, key file path is local)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-adminsdk.json

# Email/domain settings
COMPANY_EMAIL_DOMAIN=letstransport.team
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=LetsTransport
VENDOR_EMAILS=vendor1@example.com,vendor2@example.com
